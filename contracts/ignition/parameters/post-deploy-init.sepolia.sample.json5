{
  // 如果核心合约是通过 Ignition 部署的，可以继续复用 chain-11155111 下的部署结果。
  deployment: {
    source: "ignition",
    deploymentId: "chain-11155111",

    // 如果 WETH 不是本次部署出来的，而是外部已存在地址，直接在 addresses 里覆盖即可。
    addresses: {
      // Role aliases are local values used by this initialization script.
      bootstrapAdmin: "0x1111111111111111111111111111111111111111",
      executor: "0x2222222222222222222222222222222222222222",
      liquidityProvider: "0x3333333333333333333333333333333333333333",
      trader: "0x4444444444444444444444444444444444444444",
      weth: "0x0000000000000000000000000000000000000000",
    },
  },

  options: {
    // Sepolia / 主网不建议用 all 模式做 timelock。
    // 通常是先 plan，再 schedule，等 delay 结束后 execute。
    autoMineTimelockOnLocal: false,

    // 这里应填写你真正能签名的 EOA。
    // 如果 Treasury.multisig 已经是 Safe 多签，脚本只能用于 plan 校对，不应直接发起 schedule。
    executeCaller: "bootstrapAdmin",
    defaultFundingSender: "bootstrapAdmin",
  },

  treasury: {
    allowedTokens: [
      { token: "token", allowed: true },
      { token: "weth", allowed: true },
      { token: "mockUsdt", allowed: true },
      { token: "mockUsdc", allowed: true },
      { token: "mockWbtc", allowed: true },
    ],

    allowedRecipients: [
      { recipient: "manager", allowed: true },
      { recipient: "buybackExecutor", allowed: true },
      { recipient: "revenueDistributor", allowed: true },
    ],

    dailySpendCaps: [
      { token: "token", amount: "1000000000000000000000000" },
      { token: "weth", amount: "1000000000000000000000" },
    ],

    spenderApprovals: [
      { token: "token", spender: "manager", amount: "500000000000000000000000" },
      { token: "token", spender: "revenueDistributor", amount: "500000000000000000000000" },
      { token: "weth", spender: "buybackExecutor", amount: "1000000000000000000000" },
    ],

    spenderRevocations: [],
  },

  // Register the off-chain order worker wallet as the only permitted executor.
  limitOrderSettlement: {
    restrictedExecutor: "executor",
    onlyRestrictedExecutor: true,
  },

  funding: {
    nativeTransfers: [],
    // Mock assets are for liquidity and swap testing. Amounts use the token's raw decimals.
    tokenMints: [
      { token: "token", to: "treasury", amount: "10000000000000000000000000" },
      { token: "token", to: "liquidityProvider", amount: "1000000000000000000000000" },
      { token: "token", to: "trader", amount: "1000000000000000000000000" },

      { token: "mockUsdt", to: "liquidityProvider", amount: "10000000000000" },
      { token: "mockUsdt", to: "trader", amount: "10000000000000" },
      { token: "mockUsdc", to: "liquidityProvider", amount: "10000000000000" },
      { token: "mockUsdc", to: "trader", amount: "10000000000000" },
      { token: "mockWbtc", to: "liquidityProvider", amount: "100000000000000" },
      { token: "mockWbtc", to: "trader", amount: "100000000000000" },
    ],
    tokenTransfers: [],
  },

  // 正式环境里，推荐把 ownership 移交放在所有初始化完成之后的最后一步。
  ownershipTransfers: [],
}

{
  FluxCoreModule: {
    // 以下地址需要替换成真实测试网角色地址。
    // 正式环境建议把 bootstrapAdmin、multisig、guardian、operator 分开配置。
    bootstrapAdmin: "0x1111111111111111111111111111111111111111",
    treasurySetter: "0x1111111111111111111111111111111111111111",
    treasuryMultisig: "0x1111111111111111111111111111111111111111",
    treasuryGuardian: "0x2222222222222222222222222222222222222222",
    treasuryOperator: "0x3333333333333333333333333333333333333333",
    rewardsOperator: "0x3333333333333333333333333333333333333333",
    buybackOperator: "0x3333333333333333333333333333333333333333",
    revenueOperator: "0x3333333333333333333333333333333333333333",

    // 使用外部 WETH 时保持 false，并填写该网络已有的 WETH 地址。
    // 若仅测试 Mock 资产，可改为 true 并删除 weth 字段。
    deployMockWeth: false,
    weth: "0x0000000000000000000000000000000000000000",

    // 主代币基础参数。
    tokenName: "Flux Token",
    tokenSymbol: "FLUX",
    initialRecipient: "0x1111111111111111111111111111111111111111",
    initialSupply: "100000000000000000000000000",
    tokenCap: "1000000000000000000000000000",

    // Sepolia 联调使用 10 秒；正式上线前必须改为更长的治理延迟。
    treasuryMinDelay: "10",

    // 收入分配参数，单位均为基点。
    buybackBps: "10000",
    burnBps: "0",
  },
}
